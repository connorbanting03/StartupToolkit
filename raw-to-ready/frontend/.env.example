# ============================================================
# FRONTEND — environment variables (Railway service Variables, or .env.local)
# ============================================================

# Supabase (required) — the anon key is meant for browsers; Row Level Security protects the data
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Backend API URL
NEXT_PUBLIC_API_URL=http://localhost:8000
