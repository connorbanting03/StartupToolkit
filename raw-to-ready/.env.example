# ============================================================
# BACKEND — environment variables (Railway service Variables, or a local .env)
# ============================================================

# Supabase (required) — Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-supabase-anon-key

# CORS — comma-separated list of allowed frontend origins (localhost:3000 is always allowed)
ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com

# App config
APP_NAME=StartupToolkit
APP_ENV=production            # "development" enables /api/docs

# AI auto-fill (optional) — leave unset to keep the copy / paste flow only
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
AI_DAILY_LIMIT=20             # auto-fill calls per user per UTC day

# Affiliate link overrides (optional) — AFFILIATE_<TOOL_KEY>; see backend/config.py for keys
# AFFILIATE_SHOPIFY=https://...
# AFFILIATE_NOTION=https://...
